# Required providers
OPENAI_API_KEY=
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=

# Channel-specific accounts (optional when ZERNIO_ACCOUNT_ID is enough)
ZERNIO_WHATSAPP_ACCOUNT_ID=
ZERNIO_META_ADS_ACCOUNT_ID=
# Sole platform account displayed and queried by the Ads dashboards (Ofiprof, USD)
META_PRIMARY_AD_ACCOUNT_ID=act_1628380711555551
ZERNIO_META_ADS_SOURCE=all

# OpenAI
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Admin and public server
ADMIN_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
CRM_DATA_DIR=
ADMIN_ADS_CACHE_TTL_MS=300000
ZERNIO_REQUEST_TIMEOUT_MS=12000

# Meta conversions (optional)
META_ADS_DESTINATION_ID=
META_CONVERSION_CURRENCY=ARS
META_CONVERSION_TEST_CODE=

# Explicit operational jobs. When enabled, Admin refreshes only the newest CTWA inbox page;
# use the protected "Sincronizar atribución" action for a full historical backfill.
CTWA_BACKFILL_ENABLED=false

# Provider webhook verification, when configured by the provider
WEBHOOK_SECRET=
